{
 "name": "Thin film",
 "doc": "Interference colours: the render sets the film thickness.",
 "settings": {
  "seed": 0
 },
 "nodes": {
  "f": {
   "op": "flow",
   "in": {
    "image": "src"
   },
   "p": {
    "sigma": 6
   }
  },
  "t0": {
   "op": "expr",
   "in": {
    "I": "src"
   },
   "p": {
    "f": "90 + 380*blur(lum(I), 1.0)"
   }
  },
  "t1": {
   "op": "smear",
   "in": {
    "x": "t0",
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "length": 5
   }
  },
  "n0": {
   "op": "noise",
   "p": {
    "scale": 60,
    "octaves": 2,
    "seed": "$seed"
   }
  },
  "n1": {
   "op": "noise",
   "p": {
    "scale": 60,
    "octaves": 2,
    "seed": "$seed+1"
   }
  },
  "h": {
   "op": "expr",
   "in": {
    "n": "n1"
   },
   "p": {
    "f": "n*3"
   }
  },
  "li": {
   "op": "light",
   "in": {
    "height": "h"
   },
   "p": {
    "strength": 1.0,
    "shin": 60,
    "L": [
     -0.55,
     -0.75,
     0.9
    ]
   }
  },
  "col": {
   "op": "expr",
   "in": {
    "t1": "t1",
    "n0": "n0",
    "spec": "li.spec"
   },
   "p": {
    "f": "t = t1 + 8*n0\nlam = array([640., 545., 455.])\nR = 0.5 - 0.5*cos(4*pi*1.38*t[..., None]/lam)\nR = R**1.2\ng = R.mean(-1, keepdims=True); R = g + (R-g)*0.8\nout = 0.04 + 0.9*R*array([1.0, 0.97, 1.05])\nout = out + 0.12*spec[..., None]"
   }
  },
  "out": {
   "op": "u8",
   "in": {
    "x": "col"
   }
  }
 },
 "out": "out"
}