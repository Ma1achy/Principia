{
 "name": "Craquelure",
 "doc": "An oil painting cracking where neighbouring beginnings separate fastest. Binds data.sensitivity.",
 "settings": {
  "seed": 0
 },
 "nodes": {
  "proxy": {
   "op": "edge_density",
   "in": {
    "image": "src"
   },
   "p": {
    "s": 10
   }
  },
  "r": {
   "op": "rng",
   "p": {
    "seed": "$seed"
   }
  },
  "base": {
   "op": "preset:oil",
   "in": {
    "src": "src"
   },
   "p": {
    "seed": "$seed"
   }
  },
  "jf": {
   "op": "jitter_points",
   "in": {
    "rng": "r"
   },
   "p": {
    "spacing": 14,
    "jitter": 0.5
   }
  },
  "jc": {
   "op": "jitter_points",
   "in": {
    "rng": "jf.rng"
   },
   "p": {
    "spacing": 38,
    "jitter": 0.5
   }
  },
  "vf": {
   "op": "voronoi",
   "in": {
    "points": "jf.points"
   }
  },
  "vc": {
   "op": "voronoi",
   "in": {
    "points": "jc.points"
   }
  },
  "bf": {
   "op": "boundary",
   "in": {
    "labels": "vf"
   }
  },
  "bc": {
   "op": "boundary",
   "in": {
    "labels": "vc"
   }
  },
  "n1": {
   "op": "noise",
   "p": {
    "scale": 6,
    "octaves": 2,
    "seed": "$seed+1"
   }
  },
  "n2": {
   "op": "noise",
   "p": {
    "scale": 6,
    "octaves": 2,
    "seed": "$seed+2"
   }
  },
  "cr": {
   "op": "expr",
   "in": {
    "bf": "bf",
    "bc": "bc",
    "n1": "n1",
    "n2": "n2",
    "E": "data.sensitivity|proxy"
   },
   "p": {
    "f": "wy = 1.2*n1; wx = 1.2*n2\ndef wob(b): return ndi.map_coordinates(b.astype(float), [yy+wy, xx+wx], order=1) > 0.3\nout = (wob(bf) & (E > 0.5)) | (wob(bc) & (E > 0.25))"
   }
  },
  "lift": {
   "op": "expr",
   "in": {
    "c": "cr"
   },
   "p": {
    "f": "-gaussian(c.astype(float), 2.0)*3"
   }
  },
  "li": {
   "op": "light",
   "in": {
    "height": "lift"
   },
   "p": {
    "strength": 1.0,
    "L": [
     -0.55,
     -0.75,
     0.9
    ]
   }
  },
  "col": {
   "op": "expr",
   "in": {
    "base": "base",
    "cr": "cr",
    "diff": "li.diff"
   },
   "p": {
    "f": "c = gaussian(cr.astype(float), 0.5)\nout = base*(1-0.75*c[..., None])*(0.9+0.1*diff[..., None])\nout = out*array([1.0, 0.97, 0.88])"
   }
  },
  "out": {
   "op": "u8",
   "in": {
    "x": "col"
   }
  }
 },
 "out": "out"
}