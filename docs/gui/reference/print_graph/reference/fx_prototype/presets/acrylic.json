{
 "name": "Acrylic, sculptural",
 "doc": "Heavy-body acrylic whose brushwork follows the field: thick where bright, fine strokes in the filaments, broad where calm, lit low.",
 "settings": {
  "seed": 0,
  "depth": 22.0
 },
 "nodes": {
  "L": {
   "op": "expr",
   "in": {
    "I": "src"
   },
   "p": {
    "f": "stretch(blur(0.5*lum(I) + 0.5*I.max(-1), 1.2))"
   }
  },
  "E": {
   "op": "edge_density",
   "in": {
    "image": "src"
   },
   "p": {
    "s": 5
   }
  },
  "f": {
   "op": "field_flow",
   "in": {
    "image": "src",
    "E": "E"
   }
  },
  "fine": {
   "op": "strokes",
   "in": {
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "width": 1.1,
    "density": 0.02,
    "length": 22,
    "seed": "$seed",
    "amp_var": 0.5
   }
  },
  "broad": {
   "op": "strokes",
   "in": {
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "width": 3.6,
    "density": 0.0035,
    "length": 34,
    "seed": "$seed+1",
    "amp_var": 0.5
   }
  },
  "fine2": {
   "op": "strokes",
   "in": {
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "width": 1.1,
    "density": 0.012,
    "length": 18,
    "seed": "$seed+2",
    "amp_var": 0.5
   }
  },
  "broad2": {
   "op": "strokes",
   "in": {
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "width": 3.6,
    "density": 0.002,
    "length": 28,
    "seed": "$seed+3",
    "amp_var": 0.5
   }
  },
  "r": {
   "op": "rng",
   "p": {
    "seed": "$seed+4"
   }
  },
  "n": {
   "op": "draw",
   "in": {
    "rng": "r"
   },
   "p": {
    "kind": "normal"
   }
  },
  "ng": {
   "op": "expr",
   "in": {
    "n": "n.out"
   },
   "p": {
    "f": "gaussian(n,0.5)"
   }
  },
  "br": {
   "op": "smear",
   "in": {
    "x": "ng",
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "length": 14
   }
  },
  "hgt": {
   "op": "expr",
   "in": {
    "E": "E",
    "fine": "fine",
    "broad": "broad",
    "fine2": "fine2",
    "broad2": "broad2",
    "br": "br",
    "L": "L",
    "depth": "$depth"
   },
   "p": {
    "f": "wE = clip(E*1.5, 0, 1)\nS = clip(wE*fine + (1-wE)*broad, 0, 1.6)\nS2 = clip(wE*fine2 + (1-wE)*broad2, 0, 1.6)\nst = maximum(S, 0.85*S2)\nst = st/(1+st)*1.6\nbristle = z(br)\nLs = gaussian(L, 1.5)\nh = depth*(0.45*Ls + 0.55*Ls*st*(1+0.06*bristle)) + depth*0.12*st\nout = gaussian(h, 0.8)"
   }
  },
  "cb": {
   "op": "expr",
   "in": {
    "I": "src"
   },
   "p": {
    "f": "blur(I,0.5)"
   }
  },
  "C": {
   "op": "smear",
   "in": {
    "x": "cb",
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "length": 6
   }
  },
  "li": {
   "op": "light",
   "in": {
    "height": "hgt"
   },
   "p": {
    "strength": 1.0,
    "L": [
     -0.7,
     -0.55,
     0.5
    ],
    "shin": 22
   }
  },
  "hs": {
   "op": "expr",
   "in": {
    "hgt": "hgt",
    "depth": "$depth"
   },
   "p": {
    "f": "hgt/depth*2.5"
   }
  },
  "sh": {
   "op": "cast_shadow",
   "in": {
    "height": "hs"
   },
   "p": {
    "L": [
     -0.7,
     -0.55
    ],
    "reach": 10,
    "k": 0.55
   }
  },
  "col": {
   "op": "expr",
   "in": {
    "hgt": "hgt",
    "depth": "$depth",
    "L": "L",
    "C": "C",
    "diff": "li.diff",
    "spec": "li.spec",
    "sh": "sh"
   },
   "p": {
    "f": "ao = clip(1-(gaussian(hgt, 5)-hgt)/(depth*0.5), 0.55, 1)\nLs = gaussian(L, 1.5)\nout = C*(0.42+0.58*clip(diff, 0, 1.6)[..., None])*(sh*ao)[..., None] + 0.14*spec[..., None]*(0.4+0.6*Ls[..., None])"
   }
  },
  "out": {
   "op": "u8",
   "in": {
    "x": "col"
   }
  }
 },
 "out": "out"
}