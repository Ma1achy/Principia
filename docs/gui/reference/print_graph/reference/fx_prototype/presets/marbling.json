{
 "name": "Marbling",
 "doc": "Inks floated and combed through, dispersant rings at the edges, stones dropped on last.",
 "settings": {
  "seed": 0
 },
 "nodes": {
  "r": {
   "op": "rng",
   "p": {
    "seed": "$seed"
   }
  },
  "rg": {
   "op": "regions",
   "in": {
    "image": "src"
   },
   "p": {
    "K": 7,
    "b": 2.5,
    "mode": 7
   }
  },
  "n4": {
   "op": "noise",
   "p": {
    "scale": 90,
    "octaves": 2,
    "seed": "$seed+4"
   }
  },
  "dx": {
   "op": "expr",
   "in": {
    "n4": "n4"
   },
   "p": {
    "f": "9*sin(2*pi*yy/64 + 2*n4)"
   }
  },
  "dy": {
   "op": "expr",
   "in": {},
   "p": {
    "f": "6*sin(2*pi*xx/110 + 1.3)"
   }
  },
  "lw": {
   "op": "warp",
   "in": {
    "x": "rg.labels",
    "dy": "dy",
    "dx": "dx"
   },
   "p": {
    "order": 0
   }
  },
  "lab": {
   "op": "mode_filter",
   "in": {
    "labels": "lw"
   },
   "p": {
    "size": 7
   }
  },
  "f": {
   "op": "flow",
   "in": {
    "image": "src"
   },
   "p": {
    "sigma": 6
   }
  },
  "C0": {
   "op": "expr",
   "in": {
    "pal": "rg.palette",
    "lab": "lab"
   },
   "p": {
    "f": "(lambda C: (lambda g: g+(C-g)*0.88)(lum(C)[..., None]))(pal[lab])"
   }
  },
  "C1": {
   "op": "smear",
   "in": {
    "x": "C0",
    "tx": "f.tx",
    "ty": "f.ty"
   },
   "p": {
    "length": 3
   }
  },
  "bd": {
   "op": "boundary",
   "in": {
    "labels": "lab"
   }
  },
  "nb": {
   "op": "expr",
   "in": {
    "b": "bd"
   },
   "p": {
    "f": "b == 0"
   }
  },
  "dist": {
   "op": "distance",
   "in": {
    "mask": "nb"
   }
  },
  "st": {
   "op": "stones",
   "in": {
    "palette": "rg.palette",
    "rng": "r"
   }
  },
  "pt": {
   "op": "paper_tooth"
  },
  "col": {
   "op": "expr",
   "in": {
    "C1": "C1",
    "dist": "dist",
    "st": "st.mask",
    "scol": "st.colour",
    "pt": "pt"
   },
   "p": {
    "f": "C = C1*(1 - 0.25*exp(-dist/0.8))[..., None]\nC = C*(1-0.12*exp(-((dist-3)/1.5)**2))[..., None] + 0.12*exp(-((dist-3)/1.5)**2)[..., None]\ns = gaussian(st, 0.6)[..., None]\nC = C*(1-s) + scol*s\nC = C*0.93 + array([0.95, 0.93, 0.87])*0.07\nout = C*(1+0.02*z(pt))[..., None]"
   }
  },
  "out": {
   "op": "u8",
   "in": {
    "x": "col"
   }
  }
 },
 "out": "out"
}